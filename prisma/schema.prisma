generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ═════════════════════════════════════════════════════════════════════════════
// UltraCRM – unified schema.
//   • Every business-scoped table carries `business_id`. Server code always
//     scopes by the authenticated business (see src/lib/tenant.ts).
//   • Telephony models come from `dialer`, messaging models from `solinainbox`,
//     CRM core (Lead / Deal / unified Task / Suppression / DomainEvent) is new.
// ═════════════════════════════════════════════════════════════════════════════

// ─── Shared enums ────────────────────────────────────────────────────────────

/// Role of a user inside one business (membership role).
enum UserRole {
  owner
  manager
  agent
}

/// Agent presence, as shown on the manager screen.
enum PresenceStatus {
  offline
  available
  in_call
  wrap_up
  paused
}

enum TaskStatus {
  open
  done
  cancelled
}

enum TaskType {
  callback
  follow_up
  todo
}

enum LeadStatus {
  new
  contacted
  follow_up
  qualified
  unqualified
  converted
  lost
}

enum DealStage {
  new
  proposal
  negotiation
  won
  lost
}

enum DealStatus {
  open
  won
  lost
}

/// Messaging channel. Only `whatsapp` has a working provider today; `sms` and
/// `email` exist so data can be modelled but they are reported as "not implemented".
enum Channel {
  whatsapp
  sms
  email
}

/// Service (transactional / conversational) vs marketing – suppressions apply per scope.
enum MessageCategory {
  service
  marketing
}

enum SuppressionScope {
  /// Blocks marketing messages on every channel (WhatsApp / SMS / email).
  marketing
  /// "Do not contact": blocks marketing + service messages and outbound calls.
  all
}

enum IdentifierType {
  phone
  email
}

enum EventStatus {
  pending
  processing
  done
  failed
}

// ─── Telephony enums (from dialer) ───────────────────────────────────────────

enum DialMode {
  manual
  preview
  power
}

enum SessionStatus {
  active
  paused
  ended
}

/// Status of a contact inside a dial list (queue item) – NOT the CRM lead status.
enum QueueLeadStatus {
  pending
  locked
  in_call
  callback
  completed
  exhausted
  removed
  dnc
}

enum CallStatus {
  created
  dialing_agent
  agent_connected
  dialing_lead
  ringing
  answered
  ended
  failed
}

enum TelephonyResult {
  answered
  no_answer
  busy
  failed
  cancelled
  rejected
}

enum OutcomeKey {
  answered_interested
  answered_not_interested
  callback
  no_answer
  busy
  wrong_number
  sale
  dnc
}

enum TelephonyProvider {
  mock
  telnyx
  zadarma
}

/// How new calls pick a provider. Calls that already exist always stay on the provider that created them.
enum TelephonyRoutingMode {
  primary_only
  manual_backup
  auto_failover
}

enum TelephonyBreakerState {
  closed
  open
  half_open
}

/// requested → created | failed | uncertain; uncertain → created (a webhook proved it) | failed (proved not created) | needs_settlement.
enum TelephonyAttemptStatus {
  requested
  created
  failed
  uncertain
  needs_settlement
}

enum TelephonyFailureClass {
  provider_outage
  account
  rate_limit
  auth
  invalid_request
  timeout
  capacity
  unknown
}

enum CallDirection {
  outbound
  inbound
}

enum MonitorMode {
  listen
  whisper
  barge
}

enum MonitorStatus {
  connecting
  listening
  whispering
  speaking
  ended
  failed
}

enum RecordingStatus {
  none
  recording
  saved
  failed
}

// ─── Messaging enums (from solinainbox) ──────────────────────────────────────

enum ConversationStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum ConversationSource {
  WHATSAPP
  MOCK
  MANUAL
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  LINK
  TEMPLATE
}

enum MessageStatus {
  ACCEPTED
  UNKNOWN
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  /// Email: provider reported a bounce (see Message.bounceType hard/soft).
  BOUNCED
  /// Stopped by us before the provider accepted it (suppression / campaign cancel).
  CANCELLED
}

enum ConsentStatus {
  UNKNOWN
  OPTED_IN
  OPTED_OUT
}

enum TemplateStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  /// Meta paused the template (quality) – cannot be sent until Meta re-enables it.
  PAUSED
  /// Meta disabled the template.
  DISABLED
}

enum TemplateCategory {
  MARKETING
  UTILITY
  AUTHENTICATION
}

enum AutomationTrigger {
  NEW_INBOUND_MESSAGE
  NEW_CONVERSATION
  TAG_ADDED
  CONVERSATION_UNASSIGNED
  NO_REPLY_TIMEOUT
}

enum AutomationActionType {
  ASSIGN_AGENT
  ADD_TAG
  CHANGE_STATUS
  ADD_INTERNAL_NOTE
  SEND_CANNED_REPLY
  SEND_TEMPLATE
  CREATE_TASK
  SET_CUSTOM_FIELD
}

enum AutomationRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
}

enum RecipientStatus {
  QUEUED
  PROCESSING
  SENT
  FAILED
  SKIPPED
  UNKNOWN
}

// ═════════════════════════════════════════════════════════════════════════════
// SaaS core: plans, businesses, accounts, memberships
// ═════════════════════════════════════════════════════════════════════════════

/// Commercial plan. Enables modules and sets quotas. No billing integration yet.
model Plan {
  id             String   @id @default(cuid())
  key            String   @unique
  name           String
  description    String?
  /// Latest version (editing creates a new PlanVersion; businesses stay on theirs until explicitly moved).
  currentVersion Int      @default(1) @map("current_version")
  isArchived     Boolean  @default(false) @map("is_archived")
  /// { crm: true, messaging: true, telephony: true }
  modules        Json     @default("{}")
  /// { maxUsers, maxContacts, monthlyMessages, monthlyCallMinutes, monthlyCampaigns } – null/absent = unlimited
  quotas         Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")

  businesses Business[]
  versions   PlanVersion[]

  @@map("plans")
}

model Business {
  metaAdConnection MetaAdConnection?
  telephonyRouting  TelephonyRouting?
  telephonyHealth   TelephonyProviderHealth[]
  telephonySwitches TelephonySwitchLog[]
  telephonyCredentials TelephonyProviderCredential[]
  telephonyAgentEndpoints TelephonyAgentEndpoint[]
  callAttempts      CallAttempt[]
  salesOffers SalesOffer[]
  salesQuotes SalesQuote[]
  coachKnowledge       CoachKnowledge?
  coachSessions        CoachSession[]
  coachExamples        CoachExample[]
  id                   String          @id @default(cuid())
  name                 String
  slug                 String          @unique
  timezone             String          @default("Asia/Jerusalem")
  isActive             Boolean         @default(true) @map("is_active")
  planId               String?         @map("plan_id")
  /// Pinned package version (null = legacy plan fields / no package).
  planVersionId        String?         @map("plan_version_id")
  /// Access policy – separate from payment: active | trial | grace | suspended (+ accessUntil for trial/grace).
  accessStatus         String          @default("active") @map("access_status")
  accessUntil          DateTime?       @map("access_until")
  /// Payment state as KNOWN to the platform: manual (no billing integration – never shown as verified).
  billingStatus        String          @default("manual") @map("billing_status")
  /// Owner asked to delete the business and all its data: WhatsApp is disconnected at once; the rest is erased by
  /// the retention job at `deletionScheduledFor` (cancellable until then).
  deletionRequestedAt   DateTime?      @map("deletion_requested_at")
  deletionScheduledFor  DateTime?      @map("deletion_scheduled_for")
  deletionRequestedById String?        @map("deletion_requested_by_id")
  /// Per-business module overrides on top of the plan: { crm?, messaging?, telephony? }
  modules              Json            @default("{}")
  /// Dialer / CRM / automation settings (see src/lib/settings.ts)
  settings             Json            @default("{}")
  /// Fair worker rotation between businesses.
  lastCampaignScanAt   DateTime?       @map("last_campaign_scan_at")
  lastAutomationScanAt DateTime?       @map("last_automation_scan_at")
  lastEventScanAt      DateTime?       @map("last_event_scan_at")
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")

  plan        Plan?        @relation(fields: [planId], references: [id])
  planVersion PlanVersion? @relation(fields: [planVersionId], references: [id])

  users          User[]
  teams          Team[]
  contacts       Contact[]
  contactPhones  ContactPhone[]
  contactEmails  ContactEmail[]
  tags           Tag[]
  leads          Lead[]
  deals          Deal[]
  tasks          Task[]
  notes          Note[]
  suppressions   Suppression[]
  dncEntries     DncEntry[]
  events         DomainEvent[]
  automationJobs AutomationJob[]
  usage          UsageCounter[]
  auditLogs      AuditLog[]

  dialLists        DialList[]
  queueLeads       ListLead[]
  sessions         DialerSession[]
  calls            Call[]
  monitors         CallMonitor[]
  telephonyEvents  TelephonyEvent[]
  phoneNumbers     PhoneNumber[]
  numberOrders     NumberOrder[]
  numberConnection NumberConnection?
  scripts          Script[]
  noteDrafts       NoteDraft[]

  providerCredentials    ProviderCredential[]
  whatsappSignupSessions WhatsAppSignupSession[]
  conversations          Conversation[]
  messages               Message[]
  cannedReplies          CannedReply[]
  templates              Template[]
  automationRules        AutomationRule[]
  automationRuns         AutomationRun[]
  distributionLists      DistributionList[]
  campaigns              Campaign[]
  campaignDrafts         CampaignDraft[]
  storeConnections       StoreConnection[]
  assistantLinks         AssistantLink[]
  assistantMessages      AssistantMessage[]
  assistantDeliveries    AssistantDelivery[]
  carts                  Cart[]
  conversationDrafts     ConversationDraft[]
  marketingSequences     MarketingSequence[]
  sequenceRuns           SequenceRun[]
  apiKeys                ApiKey[]
  webhookEndpoints       WebhookEndpoint[]
  webhookDeliveries      WebhookDelivery[]
  dealItems              DealItem[]
  aiConversations        AiConversation[]
  aiActions              AiAction[]
  aiIncidents            AiIncident[]
  entitlementGrants      EntitlementGrant[]
  callbackSignals        CallbackSignal[]
  opsRules               OpsRule[]
  opsRecommendations     OpsRecommendation[]
  assignmentOverrides    AssignmentOverride[]
  dialerQueueAlerts      DialerQueueAlert[]
  knowledgeSources       KnowledgeSource[]

  @@map("businesses")
}

/// A person who can log in. One account can be a member of several businesses.
model Account {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String    @map("password_hash")
  fullName        String    @map("full_name")
  isActive        Boolean   @default(true) @map("is_active")
  /**
   * Bumped on every password change – sessions issued before it are rejected (see auth.ts).
   */
  sessionVersion  Int       @default(0) @map("session_version")
  /// Platform (not business) administrator: manages packages and business entitlements. Never grantable from a business.
  isPlatformAdmin Boolean   @default(false) @map("is_platform_admin")
  lastLoginAt     DateTime? @map("last_login_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  memberships User[]

  @@map("accounts")
}

/// Membership of an account in a business ("business user"). All operational
/// data (calls, tasks, conversations…) references this row, never the Account.
model User {
  id            String         @id @default(cuid())
  businessId    String         @map("business_id")
  accountId     String         @map("account_id")
  /// Denormalised from Account for display/search.
  email         String
  fullName      String         @map("full_name")
  role          UserRole       @default(agent)
  teamId        String?        @map("team_id")
  isActive      Boolean        @default(true) @map("is_active")
  /// Personal mobile (E.164) – new-lead WhatsApp notifications are sent here.
  personalPhone String?        @map("personal_phone")
  crmSettings   Json?          @map("crm_settings")
  /// Module access for this user (src/lib/access): { template, scope: own|team|business, modules: { crm: { enabled, actions[] }, … } }.
  /// Null = not migrated yet → derived from the role (never "everything").
  permissions   Json?
  avatarUrl     String?        @map("avatar_url")
  presence      PresenceStatus @default(offline)
  presenceAt    DateTime       @default(now()) @map("presence_at")
  /// Real-time sales coach shown to this agent (business-level switch in settings.coach). 
  coachEnabled  Boolean        @default(true) @map("coach_enabled")
  lastSeenAt    DateTime?      @map("last_seen_at")

  /// Telnyx telephony credential (one per business user).
  telnyxCredentialId String? @map("telnyx_credential_id")
  sipUsername        String? @map("sip_username")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  business              Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  account               Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  team                  Team?               @relation("TeamMembers", fields: [teamId], references: [id])
  managedTeams          Team[]              @relation("TeamManager")
  sessions              DialerSession[]
  calls                 Call[]
  tasks                 Task[]              @relation("TaskAssignee")
  createdTasks          Task[]              @relation("TaskCreator")
  lockedLeads           ListLead[]          @relation("LockedLeads")
  listAgents            DialListAgent[]
  ownedContacts         Contact[]           @relation("ContactOwner")
  ownedLeads            Lead[]              @relation("LeadOwner")
  ownedDeals            Deal[]              @relation("DealOwner")
  notes                 Note[]
  auditLogs             AuditLog[]
  noteDrafts            NoteDraft[]
  dncEntries            DncEntry[]
  suppressions          Suppression[]       @relation("SuppressionCreator")
  monitors              CallMonitor[]
  assignedConversations Conversation[]      @relation("AssignedAgent")
  messagesSent          Message[]           @relation("SentByUser")
  drafts                ConversationDraft[]
  cannedReplies         CannedReply[]       @relation("CreatedByUser")
  campaigns             Campaign[]
  assistantLinks        AssistantLink[]     @relation("AssistantLinkUser")

  @@unique([businessId, accountId])
  @@unique([businessId, email])
  @@index([accountId])
  @@index([businessId, presence])
  @@map("users")
}

model Team {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  name       String
  managerId  String?  @map("manager_id")
  createdAt  DateTime @default(now()) @map("created_at")

  business        Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  manager         User?                @relation("TeamManager", fields: [managerId], references: [id])
  members         User[]               @relation("TeamMembers")
  whatsappNumbers ProviderCredential[]

  @@index([businessId])
  @@map("teams")
}

/// Monthly usage per business for quota enforcement.
model UsageCounter {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  /// e.g. messages_sent, calls_started, call_minutes, campaigns_started
  metric     String
  /// "YYYY-MM"
  period     String
  value      Int      @default(0)
  updatedAt  DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, metric, period])
  @@map("usage_counters")
}

// ═════════════════════════════════════════════════════════════════════════════
// CRM core
// ═════════════════════════════════════════════════════════════════════════════

/// Single source of truth for people. Messaging and telephony reference `contactId`.
model Contact {
  id           String  @id @default(cuid())
  businessId   String  @map("business_id")
  fullName     String  @map("full_name")
  /// Primary phone, E.164, unique per business. Additional phones live in ContactPhone.
  phoneE164    String  @map("phone_e164")
  phoneRaw     String  @map("phone_raw")
  /// Primary email (lower-cased). Additional emails live in ContactEmail.
  email        String?
  company      String?
  city         String?
  source       String?
  notes        String?
  customFields Json?   @map("custom_fields")
  ownerUserId  String? @map("owner_user_id")

  // Marketing consent (WhatsApp / SMS / email share one consent record + Suppression table)
  consentStatus   ConsentStatus @default(UNKNOWN) @map("consent_status")
  consentAt       DateTime?     @map("consent_at")
  consentSource   String?       @map("consent_source")
  consentEvidence String?       @map("consent_evidence")
  consentScope    String?       @map("consent_scope")
  lastMarketingAt DateTime?     @map("last_marketing_at")
  /// Hard block for every outbound message (service included).
  isBlocked       Boolean       @default(false) @map("is_blocked")
  /// Primary email deliverability: null/valid | soft_bounce | hard_bounce (hard = never retried).
  emailStatus     String?       @map("email_status")
  emailBouncedAt  DateTime?     @map("email_bounced_at")

  /// Set when the contact becomes a customer (a deal was won) – "לקוחות קיימים".
  customerSince  DateTime? @map("customer_since")
  lastActivityAt DateTime? @map("last_activity_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  business           Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  owner              User?                    @relation("ContactOwner", fields: [ownerUserId], references: [id])
  phones             ContactPhone[]
  emails             ContactEmail[]
  tags               ContactTag[]
  leads              Lead[]
  deals              Deal[]
  tasks              Task[]
  noteItems          Note[]
  suppressions       Suppression[]
  events             DomainEvent[]
  queueLeads         ListLead[]
  calls              Call[]
  drafts             NoteDraft[]
  conversations      Conversation[]
  listMemberships    DistributionListMember[]
  campaignRecipients CampaignRecipient[]
  sequenceRuns       SequenceRun[]
  carts              Cart[]

  @@unique([businessId, phoneE164])
  @@index([businessId, fullName])
  @@index([businessId, email])
  @@index([businessId, source])
  @@index([businessId, ownerUserId])
  @@index([businessId, lastActivityAt])
  @@map("contacts")
}

model ContactPhone {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  contactId  String   @map("contact_id")
  e164       String
  label      String?
  createdAt  DateTime @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([businessId, e164])
  @@index([contactId])
  @@map("contact_phones")
}

model ContactEmail {
  id         String    @id @default(cuid())
  businessId String    @map("business_id")
  contactId  String    @map("contact_id")
  email      String
  label      String?
  status     String?
  bouncedAt  DateTime? @map("bounced_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([businessId, email])
  @@index([contactId])
  @@map("contact_emails")
}

model Tag {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  name       String
  color      String   @default("#6366f1")
  createdAt  DateTime @default(now()) @map("created_at")

  business      Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contacts      ContactTag[]
  conversations ConversationTag[]

  @@unique([businessId, name])
  @@map("tags")
}

model ContactTag {
  contactId String @map("contact_id")
  tagId     String @map("tag_id")

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@map("contact_tags")
}

/// A sales opportunity at its earliest stage. A contact can have many leads over time.
model Lead {
  salesQuotes SalesQuote[]
  id          String     @id @default(cuid())
  businessId  String     @map("business_id")
  contactId   String     @map("contact_id")
  title       String?
  status      LeadStatus @default(new)
  sourceAttribution Json @default("{}") @map("source_attribution")
  source      String?
  ownerUserId String?    @map("owner_user_id")
  priority    Int        @default(0)
  notes       String?
  /// Set when the lead was converted into a deal.
  dealId      String?    @map("deal_id")
  closedAt    DateTime?  @map("closed_at")
  /// Why the lead was closed automatically (e.g. "מוצו ניסיונות חיוג").
  closeReason String?    @map("close_reason")
  /// A closed lead handed to another agent restarts as "new": attempts are counted from here (earlier ones stay in history).
  reopenedAt  DateTime?  @map("reopened_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  business                Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /// Manager transfer requested while the lead was in a live call / dial attempt – applied once the call's outcome is saved.
  pendingTransferToUserId String?   @map("pending_transfer_to_user_id")
  pendingTransferById     String?   @map("pending_transfer_by_id")
  pendingTransferAt       DateTime? @map("pending_transfer_at")

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  owner   User?   @relation("LeadOwner", fields: [ownerUserId], references: [id])
  tasks   Task[]
  deals   Deal[]

  @@index([businessId, status, createdAt])
  @@index([businessId, ownerUserId, status])
  @@index([contactId])
  @@map("leads")
}

model Deal {
  id              String     @id @default(cuid())
  businessId      String     @map("business_id")
  contactId       String     @map("contact_id")
  leadId          String?    @map("lead_id")
  title           String
  amount          Decimal    @default(0) @db.Decimal(14, 2)
  currency        String     @default("ILS")
  stage           DealStage  @default(new)
  status          DealStatus @default(open)
  ownerUserId     String?    @map("owner_user_id")
  expectedCloseAt DateTime?  @map("expected_close_at")
  closedAt        DateTime?  @map("closed_at")
  notes           String?
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  business  Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contact   Contact    @relation(fields: [contactId], references: [id], onDelete: Cascade)
  lead      Lead?      @relation(fields: [leadId], references: [id])
  owner     User?      @relation("DealOwner", fields: [ownerUserId], references: [id])
  tasks     Task[]
  items     DealItem[]
  noteItems Note[]

  @@index([businessId, status, stage])
  @@index([businessId, ownerUserId])
  @@index([contactId])
  @@map("deals")
}

/// Unified task: dialer callbacks, messaging follow-ups and plain to-dos.
model Task {
  id             String     @id @default(cuid())
  businessId     String     @map("business_id")
  /// Assignee.
  userId         String     @map("user_id")
  createdById    String?    @map("created_by_id")
  contactId      String     @map("contact_id")
  leadId         String?    @map("lead_id")
  dealId         String?    @map("deal_id")
  /// Dial-list queue item (telephony).
  listLeadId     String?    @map("list_lead_id")
  callId         String?    @map("call_id")
  conversationId String?    @map("conversation_id")
  type           TaskType   @default(callback)
  title          String?
  dueAt          DateTime   @map("due_at")
  status         TaskStatus @default(open)
  note           String?
  /// Client idempotency key (unique per business).
  requestKey     String?    @map("request_key")
  version        Int        @default(0)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  doneAt         DateTime?  @map("done_at")

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user         User          @relation("TaskAssignee", fields: [userId], references: [id])
  createdBy    User?         @relation("TaskCreator", fields: [createdById], references: [id])
  contact      Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  lead         Lead?         @relation(fields: [leadId], references: [id])
  deal         Deal?         @relation(fields: [dealId], references: [id])
  listLead     ListLead?     @relation(fields: [listLeadId], references: [id])
  call         Call?         @relation(fields: [callId], references: [id])
  conversation Conversation? @relation(fields: [conversationId], references: [id])

  @@unique([businessId, requestKey])
  @@index([userId, status, dueAt])
  @@index([businessId, status, dueAt])
  @@index([contactId, status])
  @@index([callId])
  @@index([listLeadId])
  @@index([conversationId])
  @@map("tasks")
}

/// Internal note on a contact / conversation / deal (part of the activity timeline).
model Note {
  id               String   @id @default(cuid())
  businessId       String   @map("business_id")
  contactId        String?  @map("contact_id")
  conversationId   String?  @map("conversation_id")
  dealId           String?  @map("deal_id")
  authorId         String   @map("author_id")
  body             String
  mentionedUserIds String[] @default([]) @map("mentioned_user_ids")
  createdAt        DateTime @default(now()) @map("created_at")

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contact      Contact?      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id])
  deal         Deal?         @relation(fields: [dealId], references: [id])
  author       User          @relation(fields: [authorId], references: [id])

  @@index([businessId, contactId, createdAt])
  @@index([conversationId])
  @@map("notes")
}

/// Global unsubscribe / do-not-contact record. One row per identifier (phone or
/// email) and scope. Active while `revoked_at` is NULL (partial unique index in SQL).
model Suppression {
  id               String           @id @default(cuid())
  businessId       String           @map("business_id")
  contactId        String?          @map("contact_id")
  identifierType   IdentifierType   @map("identifier_type")
  /// E.164 phone or lower-cased email.
  identifier       String
  scope            SuppressionScope @default(marketing)
  /// Channel that produced the request: whatsapp | sms | email | phone | manual | import | api
  source           String
  reason           String?
  /// Provider message id / agent note / import file reference.
  evidence         String?
  createdByUserId  String?          @map("created_by_user_id")
  createdAt        DateTime         @default(now()) @map("created_at")
  revokedAt        DateTime?        @map("revoked_at")
  revokedByUserId  String?          @map("revoked_by_user_id")
  /// Documented re-consent (required to revoke).
  revokeEvidence   String?          @map("revoke_evidence")
  /// An unclear inbound request: marketing is held until a manager confirms or dismisses it.
  pendingReview    Boolean          @default(false) @map("pending_review")
  reviewedAt       DateTime?        @map("reviewed_at")
  reviewedByUserId String?          @map("reviewed_by_user_id")
  /// Message that produced the request (inbound reply, bounce/complaint, unsubscribe link).
  messageId        String?          @map("message_id")

  business  Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  createdBy User?    @relation("SuppressionCreator", fields: [createdByUserId], references: [id])

  @@index([businessId, identifier, revokedAt])
  @@index([businessId, contactId])
  @@index([businessId, pendingReview])
  @@map("suppressions")
}

/// Do-not-call list (telephony). Scope `all` suppressions also write here.
model DncEntry {
  id              String   @id @default(cuid())
  businessId      String   @map("business_id")
  phoneE164       String   @map("phone_e164")
  reason          String?
  createdByUserId String?  @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  business  Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy User?    @relation(fields: [createdByUserId], references: [id])

  @@unique([businessId, phoneE164])
  @@map("dnc_entries")
}

// ─── Cross-module events (outbox) ────────────────────────────────────────────

/// Shared event contract: id, business, contact, occurredAt, source, type, payload.
/// Written in the same transaction as the business change (outbox); processed by
/// the event worker (inline kick + cron). `dedupe_key` prevents double emission.
model DomainEvent {
  id            String      @id @default(cuid())
  businessId    String      @map("business_id")
  contactId     String?     @map("contact_id")
  actorUserId   String?     @map("actor_user_id")
  /// lead.created | call.ended | call.outcome_saved | message.received | message.sent | contact.suppressed | task.created …
  type          String
  /// user | system | automation | webhook | import
  source        String      @default("system")
  /// Automation chain depth – prevents loops.
  depth         Int         @default(0)
  dedupeKey     String      @map("dedupe_key")
  payload       Json        @default("{}")
  occurredAt    DateTime    @default(now()) @map("occurred_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  status        EventStatus @default(pending)
  attempts      Int         @default(0)
  nextAttemptAt DateTime?   @map("next_attempt_at")
  lockedAt      DateTime?   @map("locked_at")
  processedAt   DateTime?   @map("processed_at")
  lastError     String?     @map("last_error")

  business Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contact  Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)
  jobs     AutomationJob[]

  @@unique([businessId, dedupeKey])
  @@index([status, nextAttemptAt])
  @@index([businessId, contactId, occurredAt])
  @@index([businessId, type, occurredAt])
  @@map("domain_events")
}

/// One handler execution per event – unique ⇒ a handler never runs twice for the same event.
model AutomationJob {
  id          String    @id @default(cuid())
  businessId  String    @map("business_id")
  eventId     String    @map("event_id")
  handler     String
  status      String    @default("done")
  result      Json?
  error       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  business Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  event    DomainEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, handler])
  @@index([businessId, createdAt])
  @@map("automation_jobs")
}

model AuditLog {
  id             String   @id @default(cuid())
  businessId     String   @map("business_id")
  actorId        String?  @map("actor_id")
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id")
  action         String
  conversationId String?  @map("conversation_id")
  payload        Json?
  createdAt      DateTime @default(now()) @map("created_at")

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  actor        User?         @relation(fields: [actorId], references: [id])
  conversation Conversation? @relation(fields: [conversationId], references: [id])

  @@index([businessId, entityType, entityId])
  @@index([businessId, createdAt])
  @@map("audit_logs")
}

// ═════════════════════════════════════════════════════════════════════════════
// Telephony module (dialer)
// ═════════════════════════════════════════════════════════════════════════════

model DialList {
  id                   String    @id @default(cuid())
  businessId           String    @map("business_id")
  name                 String
  description          String?
  isActive             Boolean   @default(true) @map("is_active")
  priority             Int       @default(0)
  /// Saved CRM filter used to build/refresh this list (source, city, owner, createdAfter …)
  filterJson           Json?     @map("filter_json")
  maxAttempts          Int?      @map("max_attempts")
  /// Unanswered real dial attempts before the lead moves to "unqualified" (null = agent/business setting, 0 = off).
  unansweredLimit      Int?      @map("unanswered_limit")
  retryIntervalMinutes Int?      @map("retry_interval_minutes")
  /// {start:"09:00", end:"20:00", days:[0,1,2,3,4], timezone:"Asia/Jerusalem"}
  dialWindowJson       Json?     @map("dial_window_json")
  scriptId             String?   @map("script_id")
  /// Outbound caller id for this list/campaign (falls back to the business default).
  phoneNumberId        String?   @map("phone_number_id")
  /// Outbound number policy for this campaign: { mode: fixed|agent|round_robin|load, numberIds: [] }
  numberPolicy         Json      @default("{}") @map("number_policy")
  /// Dynamic lists re-apply filterJson on refresh; frozen lists keep their membership.
  isDynamic            Boolean   @default(false) @map("is_dynamic")
  isPaused             Boolean   @default(false) @map("is_paused")
  archivedAt           DateTime? @map("archived_at")
  lastRefreshedAt      DateTime? @map("last_refreshed_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  business    Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  script      Script?         @relation(fields: [scriptId], references: [id])
  phoneNumber PhoneNumber?    @relation("ListCallerId", fields: [phoneNumberId], references: [id])
  agents      DialListAgent[]
  leads       ListLead[]
  sessions    DialerSession[]
  calls       Call[]

  @@index([businessId, isActive])
  @@map("dial_lists")
}

model DialListAgent {
  listId    String   @map("list_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  list DialList @relation(fields: [listId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([listId, userId])
  @@map("dial_list_agents")
}

/// A contact queued in a dial list (the dialer's work item).
model ListLead {
  id               String          @id @default(cuid())
  businessId       String          @map("business_id")
  listId           String          @map("list_id")
  contactId        String          @map("contact_id")
  status           QueueLeadStatus @default(pending)
  priority         Int             @default(0)
  followUpAttempts Int?            @map("follow_up_attempts")
  attempts         Int             @default(0)
  lastAttemptAt    DateTime?       @map("last_attempt_at")
  nextAttemptAt    DateTime?       @map("next_attempt_at")
  lastOutcome      OutcomeKey?     @map("last_outcome")
  lastSkipReason   String?         @map("last_skip_reason")
  preferredUserId  String?         @map("preferred_user_id")
  claimReason      String?         @map("claim_reason")
  claimScore       Float?          @map("claim_score")
  lockedByUserId   String?         @map("locked_by_user_id")
  lockToken        String?         @map("lock_token")
  lockExpiresAt    DateTime?       @map("lock_expires_at")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  list     DialList @relation(fields: [listId], references: [id], onDelete: Cascade)
  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  lockedBy User?    @relation("LockedLeads", fields: [lockedByUserId], references: [id])
  calls    Call[]
  tasks    Task[]

  @@unique([listId, contactId])
  @@index([listId, status, priority, nextAttemptAt])
  @@index([lockedByUserId])
  @@map("list_leads")
}

model DialerSession {
  id               String        @id @default(cuid())
  businessId       String        @map("business_id")
  userId           String        @map("user_id")
  listId           String?       @map("list_id")
  mode             DialMode
  status           SessionStatus @default(active)
  browserSessionId String        @map("browser_session_id")
  countdownSeconds Int           @default(5) @map("countdown_seconds")
  startedAt        DateTime      @default(now()) @map("started_at")
  lastHeartbeatAt  DateTime      @default(now()) @map("last_heartbeat_at")
  endedAt          DateTime?     @map("ended_at")
  dialsCount       Int           @default(0) @map("dials_count")

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  list     DialList? @relation(fields: [listId], references: [id])
  calls    Call[]

  @@index([userId, status])
  @@map("dialer_sessions")
}

model Call {
  coachSession   CoachSession?
  id             String            @id @default(cuid())
  businessId     String            @map("business_id")
  userId         String            @map("user_id")
  sessionId      String?           @map("session_id")
  listId         String?           @map("list_id")
  leadId         String?           @map("lead_id")
  contactId      String?           @map("contact_id")
  mode           DialMode
  direction      CallDirection     @default(outbound)
  provider       TelephonyProvider
  idempotencyKey String            @unique @map("idempotency_key")
  routingNote    String?           @map("routing_note")
  conferenceId   String?           @map("conference_id")
  activeForUser  String?           @unique @map("active_for_user")

  toE164                String  @map("to_e164")
  fromE164              String  @map("from_e164")
  phoneNumberId         String? @map("phone_number_id")
  /// Why this caller id was chosen: fixed | sticky_lead | agent | round_robin | load
  numberSelectionReason String? @map("number_selection_reason")

  status          CallStatus       @default(created)
  telephonyResult TelephonyResult? @map("telephony_result")
  hangupCause     String?          @map("hangup_cause")
  hangupSource    String?          @map("hangup_source")
  amdResult       String?          @map("amd_result")
  failureReason   String?          @map("failure_reason")

  agentLegId        String?   @map("agent_leg_id")
  leadLegId         String?   @map("lead_leg_id")
  providerSessionId String?   @map("provider_session_id")
  dialPendingSince  DateTime? @map("dial_pending_since")
  leadDialedAt      DateTime? @map("lead_dialed_at")
  hangupRequestedAt DateTime? @map("hangup_requested_at")
  lastEventAt       DateTime? @map("last_event_at")

  createdAt       DateTime  @default(now()) @map("created_at")
  agentAnsweredAt DateTime? @map("agent_answered_at")
  ringingAt       DateTime? @map("ringing_at")
  answeredAt      DateTime? @map("answered_at")
  endedAt         DateTime? @map("ended_at")
  talkSeconds     Int?      @map("talk_seconds")

  outcome        OutcomeKey?
  outcomeNote    String?     @map("outcome_note")
  outcomeSavedAt DateTime?   @map("outcome_saved_at")
  callbackAt     DateTime?   @map("callback_at")

  recordingStatus     RecordingStatus @default(none) @map("recording_status")
  recordingId         String?         @map("recording_id")
  recordingDurationMs Int?            @map("recording_duration_ms")
  recordingFormat     String?         @map("recording_format")

  business    Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id])
  session     DialerSession?   @relation(fields: [sessionId], references: [id])
  list        DialList?        @relation(fields: [listId], references: [id])
  lead        ListLead?        @relation(fields: [leadId], references: [id])
  contact     Contact?         @relation(fields: [contactId], references: [id])
  phoneNumber PhoneNumber?     @relation(fields: [phoneNumberId], references: [id])
  events      TelephonyEvent[]
  tasks       Task[]
  monitors    CallMonitor[]
  attempts    CallAttempt[]

  @@index([businessId, createdAt])
  @@index([businessId, phoneNumberId, createdAt])
  @@index([businessId, toE164, createdAt])
  @@index([userId, createdAt])
  @@index([contactId, createdAt])
  @@index([leadId])
  @@index([userId, endedAt, outcomeSavedAt])
  @@index([agentLegId])
  @@index([leadLegId])
  @@map("calls")
}

model CallMonitor {
  id               String        @id @default(cuid())
  businessId       String        @map("business_id")
  callId           String        @map("call_id")
  managerId        String        @map("manager_id")
  activeForManager String?       @unique @map("active_for_manager")
  mode             MonitorMode   @default(listen)
  status           MonitorStatus @default(connecting)
  legId            String?       @map("leg_id")
  error            String?
  startedAt        DateTime      @default(now()) @map("started_at")
  joinedAt         DateTime?     @map("joined_at")
  endedAt          DateTime?     @map("ended_at")
  lastEventAt      DateTime?     @map("last_event_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  call     Call     @relation(fields: [callId], references: [id], onDelete: Cascade)
  manager  User     @relation(fields: [managerId], references: [id])

  @@index([callId, status])
  @@index([legId])
  @@map("call_monitors")
}

model TelephonyEvent {
  id              String            @id @default(cuid())
  businessId      String?           @map("business_id")
  callId          String?           @map("call_id")
  provider        TelephonyProvider
  providerEventId String            @map("provider_event_id")
  eventType       String            @map("event_type")
  legId           String?           @map("leg_id")
  occurredAt      DateTime?         @map("occurred_at")
  receivedAt      DateTime          @default(now()) @map("received_at")
  processedAt     DateTime?         @map("processed_at")
  payload         Json

  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  call     Call?     @relation(fields: [callId], references: [id])

  @@index([processedAt, receivedAt])
  @@unique([provider, providerEventId])
  /// Under RLS the enum-led unique index is not usable (enum "=" is not leakproof) → lookups by event id use this one.
  @@index([providerEventId])
  @@index([callId])
  @@map("telephony_events")
}

model PhoneNumber {
  id                  String            @id @default(cuid())
  businessId          String            @map("business_id")
  e164                String
  label               String?
  provider            TelephonyProvider @default(telnyx)
  isDefault           Boolean           @default(false) @map("is_default")
  isActive            Boolean           @default(true) @map("is_active")
  // ─── outbound number management ───
  /// Temporarily excluded from outbound selection (manager action, e.g. after a spam report).
  outboundPaused      Boolean           @default(false) @map("outbound_paused")
  /// unverified | verified | inactive – ownership proven against the provider inventory (24h freshness).
  verificationStatus  String            @default("unverified") @map("verification_status")
  verifiedAt          DateTime?         @map("verified_at")
  providerNumberId    String?           @map("provider_number_id")
  providerData        Json?             @map("provider_data")
  /// Purchase quote that was paid (as returned by the provider) – never estimated.
  costs               Json?
  assignedUserId      String?           @map("assigned_user_id")
  callbackUserId      String?           @map("callback_user_id")
  maxConcurrent       Int?              @map("max_concurrent")
  maxDailyAttempts    Int?              @map("max_daily_attempts")
  lastSelectedAt      DateTime?         @map("last_selected_at")
  /// clear | spam | unknown | failed | unsupported – exactly what the source reported.
  reputationStatus    String            @default("unsupported") @map("reputation_status")
  reputationSource    String            @default("truecaller") @map("reputation_source")
  reputationCheckedAt DateTime?         @map("reputation_checked_at")
  reputationData      Json?             @map("reputation_data")
  /// required | open | resolved – manager review after a spam mark.
  reputationReview    String?           @map("reputation_review")
  createdAt           DateTime          @default(now()) @map("created_at")

  business Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  calls    Call[]
  lists    DialList[] @relation("ListCallerId")

  @@unique([businessId, e164])
  @@map("phone_numbers")
}

model Script {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  title      String
  body       String
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  business Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  lists    DialList[]

  @@map("scripts")
}

model NoteDraft {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  userId     String   @map("user_id")
  contactId  String   @map("contact_id")
  body       String
  updatedAt  DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([userId, contactId])
  @@map("note_drafts")
}

// ═════════════════════════════════════════════════════════════════════════════
// Messaging module (solinainbox)
// ═════════════════════════════════════════════════════════════════════════════

/// Real connection state of a WhatsApp number (never "connected" just because a window closed).
enum WaConnectionStatus {
  disconnected
  in_progress
  needs_action
  connected_not_ready
  connected
  revoked
  error
}

/// Per-business provider connection. `provider`: meta_whatsapp_cloud_api | mock.
/// Secrets inside `config` (accessToken, appSecret, twoStepPin) are encrypted at rest (src/lib/crypto.ts).
/// (Telephony credentials remain server env vars – see docs/DEPLOYMENT.md.)
model ProviderCredential {
  id                     String             @id @default(cuid())
  businessId             String             @map("business_id")
  channel                Channel            @default(whatsapp)
  provider               String
  label                  String?
  displayPhoneNumber     String?            @map("display_phone_number")
  /// Meta phone number id – globally unique so webhooks can route to the owning business.
  phoneNumberId          String?            @unique @map("phone_number_id")
  /// Meta WhatsApp Business Account id (webhooks such as account_update route by it).
  wabaId                 String?            @map("waba_id")
  wabaName               String?            @map("waba_name")
  metaBusinessId         String?            @map("meta_business_id")
  verifiedName           String?            @map("verified_name")
  nameStatus             String?            @map("name_status")
  qualityRating          String?            @map("quality_rating")
  /// Meta messaging limit tier (TIER_250 / TIER_1K / TIER_10K / TIER_100K / TIER_UNLIMITED), from the phone number or
  /// phone_number_quality_update webhooks.
  messagingLimitTier     String?            @map("messaging_limit_tier")
  /// Meta user ids linked to this connection (token owner from debug_token + the person who ran Embedded Signup) –
  /// how a Meta data-deletion / deauthorize callback finds it.
  metaUserIds            String[]           @default([]) @map("meta_user_ids")
  codeVerificationStatus String?            @map("code_verification_status")
  platformType           String?            @map("platform_type")
  /// manual | embedded_signup
  connectionMethod       String             @default("manual") @map("connection_method")
  status                 WaConnectionStatus @default(disconnected)
  /// Scopes granted to the business token, as reported by /debug_token.
  grantedScopes          Json?              @map("granted_scopes")
  subscribedAt           DateTime?          @map("subscribed_at")
  registeredAt           DateTime?          @map("registered_at")
  tokenCheckedAt         DateTime?          @map("token_checked_at")
  lastOutboundTestAt     DateTime?          @map("last_outbound_test_at")
  teamId                 String?            @map("team_id")
  isDefault              Boolean            @default(false) @map("is_default")
  isActive               Boolean            @default(false) @map("is_active")
  config                 Json               @default("{}")
  sendingBlocked         Boolean            @default(false) @map("sending_blocked")
  lastCheckedAt          DateTime?          @map("last_checked_at")
  lastWebhookAt          DateTime?          @map("last_webhook_at")
  lastConnectionError    String?            @map("last_connection_error")
  // ─── SMS / email (channel-generic) ───
  /// Email: display name / from address / reply-to. SMS: unused.
  senderName             String?            @map("sender_name")
  senderEmail            String?            @map("sender_email")
  replyTo                String?            @map("reply_to")
  /// Email sending domain registered at the provider + its verification state and DNS records.
  domainName             String?            @map("domain_name")
  domainId               String?            @map("domain_id")
  /// not_started | pending | verified | failed | temporary_failure | unsupported
  domainStatus           String?            @map("domain_status")
  domainRecords          Json?              @map("domain_records")
  domainCheckedAt        DateTime?          @map("domain_checked_at")
  /// SMS: approved sender ids [{ id, type: "number"|"alphanumeric", value, inbound: bool }].
  senders                Json?
  /// Provider capabilities snapshot (inbound, deliveryReports, opens, clicks, suppressionSync…).
  capabilities           Json?
  /// Explicit test recipients (phones / emails). Test sends go ONLY to these.
  testRecipients         Json?              @map("test_recipients")
  /// Optional unit price for estimates (per SMS segment / per email). Null = unknown.
  unitPrice              Decimal?           @map("unit_price") @db.Decimal(12, 6)
  unitPriceCurrency      String?            @map("unit_price_currency")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  business       Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  team           Team?                   @relation(fields: [teamId], references: [id], onDelete: SetNull)
  conversations  Conversation[]
  campaigns      Campaign[]
  signupSessions WhatsAppSignupSession[]
  webhookEvents  ProviderWebhookEvent[]

  @@index([businessId, isActive])
  @@index([businessId, channel, isActive])
  @@index([wabaId])
  @@map("provider_credentials")
}

/// One Embedded Signup attempt. `state` is generated server-side and bound to the
/// business + user that started it (CSRF / cross-business binding protection); the
/// exchangeable code is consumed exactly once (status CAS) and never stored in clear.
model WhatsAppSignupSession {
  id             String   @id @default(cuid())
  businessId     String   @map("business_id")
  userId         String   @map("user_id")
  state          String   @unique
  /// started | code_received | completed | failed | cancelled
  status         String   @default("started")
  step           String?
  codeHash       String?  @map("code_hash")
  wabaId         String?  @map("waba_id")
  phoneNumberId  String?  @map("phone_number_id")
  metaBusinessId String?  @map("meta_business_id")
  credentialId   String?  @map("credential_id")
  error          String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  expiresAt      DateTime @map("expires_at")

  business   Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  credential ProviderCredential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)

  @@index([businessId, status, createdAt])
  @@map("whatsapp_signup_sessions")
}

model Conversation {
  id                   String             @id @default(cuid())
  businessId           String             @map("business_id")
  channel              Channel            @default(whatsapp)
  contactId            String             @map("contact_id")
  providerCredentialId String?            @map("provider_credential_id")
  /// Customer-service AI: null/"off" = not handled by AI, "ai" = AI answers, "human" = an agent took over (AI silent).
  aiMode               String?            @map("ai_mode")
  aiHandoffReason      String?            @map("ai_handoff_reason")
  aiHandoffSummary     String?            @map("ai_handoff_summary")
  aiHandoffAt          DateTime?          @map("ai_handoff_at")
  assignedAgentId      String?            @map("assigned_agent_id")
  status               ConversationStatus @default(OPEN)
  source               ConversationSource @default(MOCK)
  isSpam               Boolean            @default(false) @map("is_spam")
  lastMessageAt        DateTime?          @map("last_message_at")
  lastInboundAt        DateTime?          @map("last_inbound_at")
  unreadCount          Int                @default(0) @map("unread_count")
  sendLockToken        String?            @map("send_lock_token")
  sendLockUntil        DateTime?          @map("send_lock_until")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  business           Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contact            Contact             @relation(fields: [contactId], references: [id], onDelete: Cascade)
  providerCredential ProviderCredential? @relation(fields: [providerCredentialId], references: [id], onDelete: Restrict)
  assignedAgent      User?               @relation("AssignedAgent", fields: [assignedAgentId], references: [id])
  messages           Message[]
  tags               ConversationTag[]
  notes              Note[]
  drafts             ConversationDraft[]
  automationRuns     AutomationRun[]
  auditLogs          AuditLog[]
  tasks              Task[]

  @@index([businessId, status, lastMessageAt])
  @@index([businessId, assignedAgentId])
  @@index([contactId])
  @@index([providerCredentialId])
  @@map("conversations")
}

model Message {
  id                   String           @id @default(cuid())
  businessId           String           @map("business_id")
  conversationId       String           @map("conversation_id")
  channel              Channel          @default(whatsapp)
  category             MessageCategory  @default(service)
  direction            MessageDirection
  type                 MessageType
  body                 String?
  status               MessageStatus    @default(SENT)
  sentByUserId         String?          @map("sent_by_user_id")
  templateId           String?          @map("template_id")
  providerCredentialId String?          @map("provider_credential_id")
  /// Provider message id (Meta wamid) – used for status callbacks and de-duplication.
  providerMessageId    String?          @map("provider_message_id")
  /// Inbound idempotency: provider message id, unique.
  inboundKey           String?          @unique @map("inbound_key")
  /// Outbound idempotency: client/automation request key, unique.
  requestKey           String?          @unique @map("request_key")
  errorReason          String?          @map("error_reason")
  /// Provider error code (Meta / HTTP) for the last failure.
  errorCode            String?          @map("error_code")
  /// The failure was transient (rate limit, 5xx, network): a controlled retry may be attempted.
  retryable            Boolean          @default(false)
  acceptedAt           DateTime?        @map("accepted_at")
  sentAt               DateTime?        @map("sent_at")
  deliveredAt          DateTime?        @map("delivered_at")
  readAt               DateTime?        @map("read_at")
  failedAt             DateTime?        @map("failed_at")
  // ─── SMS / email ───
  /// Destination actually used (E.164 phone or email) – a contact may have several.
  toIdentifier         String?          @map("to_identifier")
  subject              String?
  /// SMS: number of segments / encoding (GSM-7 | UCS-2) as computed or reported by the provider.
  segments             Int?
  encoding             String?
  /// Actual provider cost when reported (never estimated here).
  costAmount           Decimal?         @map("cost_amount") @db.Decimal(12, 6)
  costCurrency         String?          @map("cost_currency")
  /// Email engagement – opens/clicks are provider signals affected by privacy proxies and scanners; never proof of reading.
  openedAt             DateTime?        @map("opened_at")
  clickedAt            DateTime?        @map("clicked_at")
  bouncedAt            DateTime?        @map("bounced_at")
  /// hard | soft
  bounceType           String?          @map("bounce_type")
  complainedAt         DateTime?        @map("complained_at")
  createdAt            DateTime         @default(now()) @map("created_at")

  business          Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversation      Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sentByUser        User?               @relation("SentByUser", fields: [sentByUserId], references: [id])
  template          Template?           @relation(fields: [templateId], references: [id])
  attachments       MessageAttachment[]
  campaignRecipient CampaignRecipient?

  @@index([conversationId, createdAt])
  @@index([businessId, providerMessageId])
  @@index([businessId, createdAt])
  @@index([businessId, channel, createdAt])
  @@map("messages")
}

model MessageAttachment {
  id              String   @id @default(cuid())
  messageId       String   @map("message_id")
  url             String
  providerMediaId String?  @map("provider_media_id")
  mimeType        String   @map("mime_type")
  fileName        String?  @map("file_name")
  sizeBytes       Int?     @map("size_bytes")
  createdAt       DateTime @default(now()) @map("created_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("message_attachments")
}

model ConversationTag {
  conversationId String @map("conversation_id")
  tagId          String @map("tag_id")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tag          Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([conversationId, tagId])
  @@map("conversation_tags")
}

model ConversationDraft {
  id             String   @id @default(cuid())
  businessId     String   @map("business_id")
  conversationId String   @map("conversation_id")
  userId         String   @map("user_id")
  body           String
  updatedAt      DateTime @updatedAt @map("updated_at")

  business     Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@map("conversation_drafts")
}

model CannedReply {
  id              String   @id @default(cuid())
  businessId      String   @map("business_id")
  title           String
  body            String
  shortcut        String?
  createdByUserId String   @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdByUser User     @relation("CreatedByUser", fields: [createdByUserId], references: [id])

  @@unique([businessId, shortcut])
  @@map("canned_replies")
}

model Template {
  id                 String           @id @default(cuid())
  businessId         String           @map("business_id")
  channel            Channel          @default(whatsapp)
  /// The provider's template name (fixed at Meta once submitted – used for sending).
  name               String
  /// Name shown in the app; editable any time (null = the provider name).
  displayName        String?          @map("display_name")
  language           String           @default("he")
  category           TemplateCategory @default(UTILITY)
  providerTemplateId String?          @map("provider_template_id")
  providerAccountId  String?          @map("provider_account_id")
  syncError          String?          @map("sync_error")
  body               String
  variables          String[]         @default([])
  status             TemplateStatus   @default(DRAFT)
  // ─── email ───
  // ─── WhatsApp (Meta) template structure ───
  /// Raw Meta components (HEADER / BODY / FOOTER / BUTTONS) as synced.
  components         Json?
  /// TEXT | IMAGE | VIDEO | DOCUMENT | null
  headerFormat       String?          @map("header_format")
  /// [{ type: QUICK_REPLY|URL|PHONE_NUMBER|COPY_CODE, text, url?, dynamic?: boolean }]
  buttons            Json?
  subject            String?
  preheader          String?
  /// Block-editor document (see src/lib/email/blocks.ts); `html`/`text` are rendered from it on save.
  design             Json?
  html               String?
  text               String?
  /// Working copy owned by a campaign draft (hidden from the template gallery).
  internal           Boolean          @default(false)
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  messages      Message[]
  campaigns     Campaign[]
  sequenceSteps SequenceStep[]

  @@unique([businessId, name, language])
  @@unique([businessId, providerTemplateId])
  @@index([providerAccountId])
  @@index([businessId, channel, status])
  @@map("templates")
}

model AutomationRule {
  id            String               @id @default(cuid())
  businessId    String               @map("business_id")
  name          String
  isActive      Boolean              @default(true) @map("is_active")
  trigger       AutomationTrigger
  triggerConfig Json                 @default("{}") @map("trigger_config")
  actionType    AutomationActionType @map("action_type")
  actionConfig  Json                 @default("{}") @map("action_config")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  business Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  runs     AutomationRun[]

  @@index([businessId, trigger, isActive])
  @@map("automation_rules")
}

model AutomationRun {
  id             String              @id @default(cuid())
  businessId     String              @map("business_id")
  ruleId         String              @map("rule_id")
  conversationId String?             @map("conversation_id")
  status         AutomationRunStatus @default(PENDING)
  scheduledFor   DateTime            @default(now()) @map("scheduled_for")
  triggerPayload Json                @default("{}") @map("trigger_payload")
  result         Json?
  error          String?
  claimedAt      DateTime?           @map("claimed_at")
  attempts       Int                 @default(0)
  createdAt      DateTime            @default(now()) @map("created_at")
  completedAt    DateTime?           @map("completed_at")

  business     Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  rule         AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  conversation Conversation?  @relation(fields: [conversationId], references: [id])

  @@index([businessId, status, scheduledFor])
  @@map("automation_runs")
}

model DistributionList {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  name       String
  segment    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  business  Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  members   DistributionListMember[]
  campaigns Campaign[]

  @@index([businessId])
  @@map("distribution_lists")
}

model DistributionListMember {
  listId    String @map("list_id")
  contactId String @map("contact_id")

  list    DistributionList @relation(fields: [listId], references: [id], onDelete: Cascade)
  contact Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@id([listId, contactId])
  @@index([contactId])
  @@map("distribution_list_members")
}

model Campaign {
  id                    String         @id @default(cuid())
  businessId            String         @map("business_id")
  channel               Channel        @default(whatsapp)
  name                  String
  listId                String         @map("list_id")
  templateId            String         @map("template_id")
  providerCredentialId  String?        @map("provider_credential_id")
  variables             Json           @default("{}")
  excludedListIds       Json           @default("[]") @map("excluded_list_ids")
  /// All selected audiences (listId is the first one – kept for the FK). Union of the lists' contacts.
  listIds               Json           @default("[]") @map("list_ids")
  audienceSnapshot      Json?          @map("audience_snapshot")
  audienceExcludedCount Int            @default(0) @map("audience_excluded_count")
  senderSnapshot        String?        @map("sender_snapshot")
  templateSnapshot      String?        @map("template_snapshot")
  createdById           String         @map("created_by_id")
  status                CampaignStatus @default(DRAFT)
  scheduledAt           DateTime?      @map("scheduled_at")
  /// Business timezone the schedule was entered in (display / audit only – scheduledAt is UTC).
  scheduledTimezone     String?        @map("scheduled_timezone")
  /// SMS: sender id chosen from the credential's approved senders.
  senderId              String?        @map("sender_id")
  /// Frozen estimate at draft time { segments, perRecipient, recipients, unitPrice, currency, total | null, known }.
  estimate              Json?
  lastTestAt            DateTime?      @map("last_test_at")
  /// WhatsApp template header media (public https link) when the template has a media header.
  mediaUrl              String?        @map("media_url")
  /// WhatsApp dynamic URL-button parameters { "<button index>": "<suffix>" }.
  buttonParams          Json?          @map("button_params")
  /// Preflight review frozen at start/resume (eligible, exclusions, blockers, sender, cost).
  preflightSnapshot     Json?          @map("preflight_snapshot")
  /// Why the campaign was paused/failed by the system (provider down, quota…).
  statusReason          String?        @map("status_reason")
  /// Sending pace: { batchSize, intervalMinutes } = at most batchSize recipients per intervalMinutes. Null = as fast as allowed.
  throttle              Json?
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")

  business           Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  list               DistributionList    @relation(fields: [listId], references: [id])
  template           Template            @relation(fields: [templateId], references: [id])
  providerCredential ProviderCredential? @relation(fields: [providerCredentialId], references: [id], onDelete: Restrict)
  createdBy          User                @relation(fields: [createdById], references: [id])
  recipients         CampaignRecipient[]
  drafts             CampaignDraft[]

  @@index([businessId, status, scheduledAt])
  @@index([businessId, channel, createdAt])
  @@index([listId])
  @@index([templateId])
  @@map("campaigns")
}

/// Step-by-step campaign builder state ("יצירת קמפיין"). A draft becomes a real Campaign when it is built at the
/// review step; `campaignId` then points at that (DRAFT/SCHEDULED) campaign, and edits rebuild it.
model CampaignDraft {
  id          String   @id @default(cuid())
  businessId  String   @map("business_id")
  channel     Channel  @default(email)
  name        String
  /// info | audience | template | content | review
  step        String   @default("info")
  /// Everything the wizard collected: subject, preheader, senderCredentialId, replyTo, listIds, excludedListIds, templateId, design, body, variables, mediaUrl, buttonParams, schedule…
  data        Json     @default("{}")
  /// Working template row (email/sms) rendered from `data` – updated on every build/test.
  templateId  String?  @map("template_id")
  campaignId  String?  @map("campaign_id")
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([businessId, channel, updatedAt])
  @@map("campaign_drafts")
}

/// An online store connected for abandoned-cart detection (site script + Shopify / WooCommerce webhooks).
model StoreConnection {
  id                  String    @id @default(cuid())
  businessId          String    @map("business_id")
  /// shopify | woocommerce | custom
  platform            String
  name                String
  /// Site host (e.g. shop.example.com) – browser events are accepted only from this origin when set.
  domain              String?
  /// Public id embedded in the site script (not a secret).
  publicKey           String    @unique @map("public_key")
  /// { webhookSecret } sealed at rest.
  config              Json      @default("{}")
  abandonAfterMinutes Int       @default(60) @map("abandon_after_minutes")
  isActive            Boolean   @default(true) @map("is_active")
  lastEventAt         DateTime? @map("last_event_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  carts    Cart[]

  @@index([businessId])
  @@map("store_connections")
}

/// A shopping cart / checkout seen on a connected store. open → abandoned (no activity) → converted / recovered (order).
model Cart {
  id                String    @id @default(cuid())
  businessId        String    @map("business_id")
  storeId           String    @map("store_id")
  /// Cart token / checkout id / session id from the store.
  externalId        String    @map("external_id")
  contactId         String?   @map("contact_id")
  email             String?
  phoneE164         String?   @map("phone_e164")
  customerName      String?   @map("customer_name")
  currency          String?
  total             Decimal?  @db.Decimal(14, 2)
  /// [{ name, quantity, price, url?, image? }]
  items             Json      @default("[]")
  checkoutUrl       String?   @map("checkout_url")
  acceptsMarketing  Boolean?  @map("accepts_marketing")
  /// open | abandoned | converted | recovered
  status            String    @default("open")
  lastActivityAt    DateTime  @default(now()) @map("last_activity_at")
  abandonedAt       DateTime? @map("abandoned_at")
  convertedAt       DateTime? @map("converted_at")
  orderId           String?   @map("order_id")
  orderTotal        Decimal?  @map("order_total") @db.Decimal(14, 2)
  /// First recovery message sent by a journey for this cart (used to attribute "recovered").
  recoveryMessageAt DateTime? @map("recovery_message_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  business Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  store    StoreConnection @relation(fields: [storeId], references: [id], onDelete: Cascade)
  contact  Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@unique([storeId, externalId])
  @@index([businessId, status, lastActivityAt])
  @@index([contactId])
  @@map("carts")
}

/// A phone number authorized to talk to the business's WhatsApp AI assistant, bound to a CRM user.
/// Activated only by sending the one-time code (issued to a signed-in user) FROM that phone to the business number.
model AssistantLink {
  id            String    @id @default(cuid())
  businessId    String    @map("business_id")
  userId        String    @map("user_id")
  phoneE164     String    @map("phone_e164")
  /// pending | active | revoked
  status        String    @default("pending")
  /// business = everything the user may see; own = only the user's own data
  scope         String    @default("business")
  codeHash      String?   @map("code_hash")
  codeExpiresAt DateTime? @map("code_expires_at")
  verifiedAt    DateTime? @map("verified_at")
  revokedAt     DateTime? @map("revoked_at")
  /// Last message FROM this phone (WhatsApp 24h service window).
  lastInboundAt DateTime? @map("last_inbound_at")
  /// Conversation memory for follow-ups: { lastIntent, lastPeriod, lastAgentId, lastContactId }
  context       Json      @default("{}")
  /// A proactive report waiting for the user to open the service window (sent with a template).
  pendingReport String?   @map("pending_report")
  createdById   String    @map("created_by_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  business Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User               @relation("AssistantLinkUser", fields: [userId], references: [id], onDelete: Cascade)
  messages AssistantMessage[]

  @@unique([businessId, phoneE164])
  @@index([phoneE164])
  @@map("assistant_links")
}

/// Protected activity log of the assistant: every request, the tools it ran and the outcome (no secrets).
model AssistantMessage {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  linkId     String?  @map("link_id")
  /// in | out
  direction  String
  /// Provider message id of an inbound message – unique, so a retried webhook is processed once.
  inboundKey String?  @unique @map("inbound_key")
  text       String
  intent     String?
  /// [{ name, args, ok, error?, ms }]
  tools      Json     @default("[]")
  /// ok | error | blocked | skipped
  status     String   @default("ok")
  error      String?
  model      String?
  latencyMs  Int?     @map("latency_ms")
  createdAt  DateTime @default(now()) @map("created_at")

  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  link     AssistantLink? @relation(fields: [linkId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([linkId, createdAt])
  @@map("assistant_messages")
}

/// Scheduled reports / alerts already sent (dedupe key per business).
model AssistantDelivery {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  key        String
  linkId     String?  @map("link_id")
  kind       String
  /// sent | template | skipped | failed
  status     String
  detail     String?
  createdAt  DateTime @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, key])
  @@index([businessId, createdAt])
  @@map("assistant_deliveries")
}

model CampaignRecipient {
  id            String          @id @default(cuid())
  campaignId    String          @map("campaign_id")
  contactId     String          @map("contact_id")
  status        RecipientStatus @default(QUEUED)
  messageId     String?         @unique @map("message_id")
  /// Phone / email the send targeted (frozen at dispatch).
  identifier    String?
  /// Send attempts so far (automatic backoff + manual retries). Each attempt has its own requestKey.
  attempts      Int             @default(0)
  /// Earliest time the next attempt may run (backoff). Null = now.
  nextAttemptAt DateTime?       @map("next_attempt_at")
  error         String?
  claimedAt     DateTime?       @map("claimed_at")
  completedAt   DateTime?       @map("completed_at")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact  Contact  @relation(fields: [contactId], references: [id])
  message  Message? @relation(fields: [messageId], references: [id])

  @@unique([campaignId, contactId])
  @@index([campaignId, status])
  @@index([status, claimedAt])
  @@index([contactId])
  @@map("campaign_recipients")
}

// ═════════════════════════════════════════════════════════════════════════════
// Multi-channel marketing: provider webhook dedupe + cross-channel sequences
// ═════════════════════════════════════════════════════════════════════════════

/// Every inbound provider event is recorded once (provider + event id). Duplicate and
/// out-of-order deliveries are detected here before anything is applied.
model ProviderWebhookEvent {
  id           String    @id @default(cuid())
  businessId   String?   @map("business_id")
  credentialId String?   @map("credential_id")
  /// telnyx_sms | resend | mock_sms | mock_email
  provider     String
  eventId      String    @map("event_id")
  type         String
  occurredAt   DateTime? @map("occurred_at")
  receivedAt   DateTime  @default(now()) @map("received_at")
  /// Applied result (for support) – no secrets, no message bodies.
  result       Json?

  credential ProviderCredential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)

  @@unique([provider, eventId])
  @@index([businessId, receivedAt])
  @@map("provider_webhook_events")
}

enum SequenceTrigger {
  /// A marketing message on `channel` was reported failed/bounced by the provider.
  DELIVERY_FAILED
  /// A marketing message was sent and the contact did not reply within the step's wait.
  SENT_NO_REPLY
  /// A tag was added to the contact.
  TAG_ADDED
  /// A new contact was created (manual, import, inbound).
  CONTACT_CREATED
  /// A lead of the contact changed status (triggerConfig.leadStatus filters).
  LEAD_STATUS_CHANGED
  /// An online-store cart with the contact's details was left without checkout (see Cart).
  CART_ABANDONED
  /// A call to the contact was not answered and the lead reached N unanswered attempts (triggerConfig.minAttempts).
  CALL_UNANSWERED
}

enum SequenceRunStatus {
  PENDING
  RUNNING
  COMPLETED
  STOPPED
  FAILED
}

/// Cross-channel follow-up: trigger → ordered steps (channel, template, wait). Eligibility
/// (consent, global suppression, frequency cap, stop conditions) is re-checked before EVERY step.
model MarketingSequence {
  id            String          @id @default(cuid())
  businessId    String          @map("business_id")
  name          String
  isActive      Boolean         @default(true) @map("is_active")
  trigger       SequenceTrigger
  /// { channel?: "whatsapp"|"sms"|"email", tagName?: string, campaignId?: string }
  triggerConfig Json            @default("{}") @map("trigger_config")
  /// Stop when: reply | conversion | unsubscribe (unsubscribe is always enforced).
  stopOn        String[]        @default(["reply", "conversion", "unsubscribe"]) @map("stop_on")
  createdById   String?         @map("created_by_id")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  steps    SequenceStep[]
  runs     SequenceRun[]

  @@index([businessId, trigger, isActive])
  @@map("marketing_sequences")
}

model SequenceStep {
  id          String  @id @default(cuid())
  sequenceId  String  @map("sequence_id")
  position    Int
  channel     Channel
  templateId  String? @map("template_id")
  /// Delay before this step (minutes) – measured from the previous step / trigger.
  waitMinutes Int     @default(0) @map("wait_minutes")
  /// Extra condition: { requireNoReply?: true, requireConsent?: true }
  /// send (template on `channel`) | task (create a follow-up task for the contact owner)
  action      String  @default("send")
  condition   Json    @default("{}")
  variables   Json    @default("{}")

  sequence MarketingSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  template Template?         @relation(fields: [templateId], references: [id])

  @@unique([sequenceId, position])
  @@map("sequence_steps")
}

/// One contact progressing through a sequence. Unique per (sequence, contact, source) so a
/// retried webhook / duplicate event never starts a second run.
model SequenceRun {
  id          String            @id @default(cuid())
  businessId  String            @map("business_id")
  sequenceId  String            @map("sequence_id")
  contactId   String            @map("contact_id")
  /// Message / campaign recipient / tag event that started the run.
  sourceKey   String            @map("source_key")
  stepIndex   Int               @default(0) @map("step_index")
  status      SequenceRunStatus @default(PENDING)
  nextAt      DateTime          @map("next_at")
  startedAt   DateTime          @default(now()) @map("started_at")
  lockedAt    DateTime?         @map("locked_at")
  stopReason  String?           @map("stop_reason")
  /// [{ step, messageId?, skipped?, at }]
  log         Json              @default("[]")
  completedAt DateTime?         @map("completed_at")

  business Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sequence MarketingSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  contact  Contact           @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([sequenceId, contactId, sourceKey])
  @@index([businessId, status, nextAt])
  @@index([contactId, status])
  @@map("sequence_runs")
}

// ═════════════════════════════════════════════════════════════════════════════
// Outbound number management (provider connection, purchases)
// ═════════════════════════════════════════════════════════════════════════════

/// Credentials stay server environment secrets; this row records an actual provider check, not key presence.
model NumberConnection {
  businessId  String    @id @map("business_id")
  /// unverified | verified | failed
  status      String    @default("unverified")
  checkedAt   DateTime? @map("checked_at")
  error       String?
  /// Hash of the credentials that were verified – a changed key invalidates the check.
  fingerprint String?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("number_connections")
}

/// One purchase attempt per (business, provider, number). States: quoted → submitting → pending → configuring → ready, or unknown.
model NumberOrder {
  id              String    @id @default(cuid())
  businessId      String    @map("business_id")
  provider        String    @default("telnyx")
  e164            String
  state           String    @default("quoted")
  quote           Json
  expiresAt       DateTime  @map("expires_at")
  confirmedBy     String?   @map("confirmed_by")
  confirmedAt     DateTime? @map("confirmed_at")
  providerOrderId String?   @map("provider_order_id")
  providerStatus  String?   @map("provider_status")
  error           String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, provider, e164])
  @@index([businessId, createdAt])
  @@map("number_orders")
}

// ───────────────────────── Real-time sales coach (AI) ─────────────────────────

enum CoachSpeaker {
  customer
  agent
  unknown
}

enum CoachSegmentSource {
  browser_stt
  simulation
  recording
  telnyx_stream
}

enum CoachSessionStatus {
  listening
  analyzing
  ready
  unavailable
  ended
}

enum CoachExampleStatus {
  pending
  approved
  rejected
}

enum CoachOutcome {
  won
  lost
  unknown
}

/// Per-business approved knowledge the coach may rely on (never invented by the model).
model CoachKnowledge {
  id              String   @id @default(cuid())
  businessId      String   @unique @map("business_id")
  description     String   @default("")
  audience        String   @default("")
  /// [{ name, price, notes }]
  products        Json     @default("[]")
  benefits        Json     @default("[]")
  /// [{ question, answer }]
  faqs            Json     @default("[]")
  /// [{ objection, response }]
  objections      Json     @default("[]")
  forbiddenClaims Json     @default("[]") @map("forbidden_claims")
  style           String   @default("")
  callGoal        String   @default("") @map("call_goal")
  updatedById     String?  @map("updated_by_id")
  updatedAt       DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("coach_knowledge")
}

/// One coach session per call: rolling summary + conversation state + usage/cost.
model CoachSession {
  id             String             @id @default(cuid())
  businessId     String             @map("business_id")
  callId         String             @unique @map("call_id")
  userId         String             @map("user_id")
  contactId      String?            @map("contact_id")
  leadId         String?            @map("lead_id")
  status         CoachSessionStatus @default(listening)
  summary        String             @default("")
  stage          String?
  customerGoal   String?            @map("customer_goal")
  lastObjection  String?            @map("last_objection")
  /// [{ text, by }] – promises / commitments made during the call
  promises       Json               @default("[]")
  segmentsCount  Int                @default(0) @map("segments_count")
  lastSegmentAt  DateTime?          @map("last_segment_at")
  sttSeconds     Float              @default(0) @map("stt_seconds")
  tokensIn       Int                @default(0) @map("tokens_in")
  tokensOut      Int                @default(0) @map("tokens_out")
  costUsd        Decimal            @default(0) @map("cost_usd") @db.Decimal(10, 5)
  latencyMsTotal Int                @default(0) @map("latency_ms_total")
  latencySamples Int                @default(0) @map("latency_samples")
  provider       String?
  /// AI documentation of the whole call: { summary, timeline:[{from,to,title,details}], customerNeeds, objections, agreements, nextSteps, sentiment, source }
  documentation  Json?
  documentedAt   DateTime?          @map("documented_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  business        Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  call            Call                  @relation(fields: [callId], references: [id], onDelete: Cascade)
  segments        CoachSegment[]
  recommendations CoachRecommendation[]
  chatMessages    CoachChatMessage[]

  @@index([businessId, createdAt])
  @@map("coach_sessions")
}

/// "נתקעתי? שאל את ה-AI" – the agent's free-text questions during a call and the coach's answers (per call).
model CoachChatMessage {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  sessionId  String   @map("session_id")
  callId     String   @map("call_id")
  role       String
  text       String
  followUp   String?  @map("follow_up")
  why        String?
  basis      String?
  /// which real sources fed the answer: { transcriptLines, lead, whatsapp, outcomes, examples, knowledge, model, latencyMs }
  sources    Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  session CoachSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@index([businessId, createdAt])
  @@map("coach_chat_messages")
}

model CoachSegment {
  id         String             @id @default(cuid())
  businessId String             @map("business_id")
  sessionId  String             @map("session_id")
  callId     String             @map("call_id")
  speaker    CoachSpeaker       @default(unknown)
  text       String
  startMs    Int?               @map("start_ms")
  endMs      Int?               @map("end_ms")
  source     CoachSegmentSource
  createdAt  DateTime           @default(now()) @map("created_at")

  session CoachSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@index([businessId])
  @@map("coach_segments")
}

model CoachRecommendation {
  id               String    @id @default(cuid())
  businessId       String    @map("business_id")
  sessionId        String    @map("session_id")
  callId           String    @map("call_id")
  objection        String?
  sayNow           String    @map("say_now")
  why              String    @default("")
  confidence       Float     @default(0)
  stage            String?
  /// examples = backed by this business's reviewed sales examples; knowledge_only = approved knowledge only; question = ask the agent
  basis            String    @default("knowledge_only")
  /// { exampleIds: [], knowledge: [], leadFacts: [] }
  sources          Json      @default("{}")
  triggerSegmentId String?   @map("trigger_segment_id")
  latencyMs        Int?      @map("latency_ms")
  shownAt          DateTime? @map("shown_at")
  feedback         String?
  supersededAt     DateTime? @map("superseded_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  session CoachSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@index([businessId, createdAt])
  @@map("coach_recommendations")
}

/// Verifiable sales moments extracted from finished calls, linked to the deal outcome. Reviewed by managers.
model CoachExample {
  id             String             @id @default(cuid())
  businessId     String             @map("business_id")
  callId         String?            @map("call_id")
  sessionId      String?            @map("session_id")
  dealId         String?            @map("deal_id")
  leadId         String?            @map("lead_id")
  userId         String?            @map("user_id")
  objection      String
  agentResponse  String             @map("agent_response")
  /// what the manager wants said instead (used when set)
  editedResponse String?            @map("edited_response")
  stage          String?
  product        String?
  outcome        CoachOutcome       @default(unknown)
  /// verbatim excerpt from the transcript so the moment can be checked
  quote          String             @default("")
  segmentIds     Json               @default("[]") @map("segment_ids")
  questions      Json               @default("[]")
  embedding      Json?
  status         CoachExampleStatus @default(pending)
  reviewedById   String?            @map("reviewed_by_id")
  reviewedAt     DateTime?          @map("reviewed_at")
  createdAt      DateTime           @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, status])
  @@index([callId])
  @@map("coach_examples")
}

/// Key for the public API (/api/v1) – Make, Zapier, n8n, custom code. Only a hash is stored; the key is shown once.
model ApiKey {
  id          String    @id @default(cuid())
  businessId  String    @map("business_id")
  name        String
  /// First characters, to recognise the key in the list ("uk_live_ab12…").
  prefix      String
  keyHash     String    @unique @map("key_hash")
  createdById String    @map("created_by_id")
  lastUsedAt  DateTime? @map("last_used_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("api_keys")
}

/// Outgoing webhook subscription (Make / Zapier "catch hook" URL etc.).
model WebhookEndpoint {
  id            String    @id @default(cuid())
  businessId    String    @map("business_id")
  url           String
  description   String?
  /// Event types, e.g. ["lead.created", "deal.won"].
  events        String[]
  /// { secret } sealed at rest – deliveries are signed with HMAC-SHA256.
  config        Json      @default("{}")
  isActive      Boolean   @default(true) @map("is_active")
  failureCount  Int       @default(0) @map("failure_count")
  lastSuccessAt DateTime? @map("last_success_at")
  lastFailureAt DateTime? @map("last_failure_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  business   Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([businessId])
  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id            String    @id @default(cuid())
  businessId    String    @map("business_id")
  endpointId    String    @map("endpoint_id")
  event         String
  /// Source event id – one delivery per endpoint and source event.
  eventKey      String    @map("event_key")
  payload       Json
  /// pending | delivered | failed
  status        String    @default("pending")
  attempts      Int       @default(0)
  responseCode  Int?      @map("response_code")
  error         String?
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at")
  deliveredAt   DateTime? @map("delivered_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  business Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@unique([endpointId, eventKey])
  @@index([businessId, status, nextAttemptAt])
  @@map("webhook_deliveries")
}

/// A product bought in a deal, with its service period (for renewals – the existing-customers dialer).
model DealItem {
  id               String    @id @default(cuid())
  businessId       String    @map("business_id")
  dealId           String    @map("deal_id")
  contactId        String    @map("contact_id")
  name             String
  quantity         Int       @default(1)
  unitPrice        Decimal   @default(0) @map("unit_price") @db.Decimal(14, 2)
  startsAt         DateTime  @map("starts_at")
  /// When the product ends – from this moment the customer is due for a renewal call.
  endsAt           DateTime? @map("ends_at")
  /// Set when a renewal was sold (or the renewal was closed) so it is not dialed again.
  renewalHandledAt DateTime? @map("renewal_handled_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  deal     Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([businessId, endsAt])
  @@index([contactId])
  @@map("deal_items")
}

/// "עוזר AI" – internal chat threads (app; WhatsApp threads of linked users are logged in AssistantMessage).
model AiConversation {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  userId     String   @map("user_id")
  title      String   @default("שיחה חדשה")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  business Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  messages AiMessage[]
  actions  AiAction[]

  @@index([businessId, userId, updatedAt])
  @@map("ai_conversations")
}

model AiMessage {
  id             String   @id @default(cuid())
  businessId     String   @map("business_id")
  conversationId String   @map("conversation_id")
  /// user | assistant
  role           String
  text           String
  /// Tools used for this answer: [{ name, ok, ms, error? }] (never raw data)
  tools          Json     @default("[]")
  model          String?
  createdAt      DateTime @default(now()) @map("created_at")

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

/// Every action the assistant proposes or performs (chat, WhatsApp, customer service, repairs) – approval + audit trail.
model AiAction {
  id               String    @id @default(cuid())
  businessId       String    @map("business_id")
  conversationId   String?   @map("conversation_id")
  incidentId       String?   @map("incident_id")
  requestedById    String?   @map("requested_by_id")
  /// app | whatsapp | service | system
  channel          String    @default("app")
  kind             String
  params           Json      @default("{}")
  summary          String
  /// Impact shown before approval (affected records, messages that would be sent, …).
  impact           String?
  /// proposed | executed | failed | cancelled | skipped
  status           String    @default("proposed")
  requiresApproval Boolean   @default(false) @map("requires_approval")
  approvedById     String?   @map("approved_by_id")
  approvedAt       DateTime? @map("approved_at")
  /// Snapshot of what is being changed (previous config) – for undo and "changed since diagnosis" checks.
  before           Json?
  result           Json?
  error            String?
  /// Idempotency (e.g. one customer-service reply per inbound message).
  dedupeKey        String?   @map("dedupe_key")
  createdAt        DateTime  @default(now()) @map("created_at")
  executedAt       DateTime? @map("executed_at")

  business     Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversation AiConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  incident     AiIncident?     @relation(fields: [incidentId], references: [id], onDelete: SetNull)

  @@unique([businessId, dedupeKey])
  @@index([businessId, createdAt])
  @@map("ai_actions")
}

/// "תקלות ותיקונים": a diagnosis requested in chat/WhatsApp, its evidence, proposed/applied fixes and verification.
model AiIncident {
  id            String   @id @default(cuid())
  businessId    String   @map("business_id")
  requestedById String?  @map("requested_by_id")
  module        String
  question      String
  /// diagnosed | approval_required | fixed_verified | changed_pending_verification | needs_code_fix | needs_external | escalated
  status        String
  /// { summary, classification, evidence:[…], unknowns:[…], fixes:[…] }
  findings      Json     @default("{}")
  verification  Json?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  business Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  actions  AiAction[]

  @@index([businessId, createdAt])
  @@map("ai_incidents")
}

/// Business knowledge for the assistant (text / document / link). New items: draft + internal only.
model KnowledgeSource {
  id                   String    @id @default(cuid())
  businessId           String    @map("business_id")
  title                String
  /// business | products | faq | policy | guidelines | docs
  category             String
  /// text | file | link | conversation ("נלמד משיחה")
  kind                 String
  /// internal | customer
  audience             String    @default("internal")
  /// draft | approved | retired ("הוצא משימוש" – never retrieved)
  status               String    @default("draft")
  /// Learned from a conversation: info (facts + service process) | style (tone only, no facts) | both
  learnMode            String?   @map("learn_mode")
  /// { question, answer, example: { q, a }, whenToUse, limits, caseSpecific[], messageIds[], redactions }
  structured           Json?
  /// Source WhatsApp conversation (the link is only useful to users who may open that conversation).
  sourceConversationId String?   @map("source_conversation_id")
  /// On approval, this item replaces (retires) the given existing item.
  supersedesId         String?   @map("supersedes_id")
  /// Possible contradictions with approved knowledge found at analysis time: [{ sourceId, title, detail }]
  conflicts            Json?
  /// pending | processing | ready | failed
  processing           String    @default("pending")
  error                String?
  content              String    @default("")
  url                  String?
  fileName             String?   @map("file_name")
  mimeType             String?   @map("mime_type")
  sizeBytes            Int?      @map("size_bytes")
  createdById          String?   @map("created_by_id")
  approvedById         String?   @map("approved_by_id")
  approvedAt           DateTime? @map("approved_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  business Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  chunks   KnowledgeChunk[]

  @@index([businessId, status, audience])
  @@index([businessId, sourceConversationId])
  @@map("knowledge_sources")
}

model KnowledgeChunk {
  id         String                   @id @default(cuid())
  businessId String                   @map("business_id")
  sourceId   String                   @map("source_id")
  position   Int
  text       String
  /// Generated full-text vector (migration 20260927200000_ai_assistant) – read-only.
  tsv        Unsupported("tsvector")?
  createdAt  DateTime                 @default(now()) @map("created_at")

  source KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([sourceId])
  @@index([tsv], type: Gin, map: "knowledge_chunks_tsv_idx")
  /// NOTE: tsv is a GENERATED column; `prisma migrate diff` reports a spurious "DROP DEFAULT" for it – never apply that line.
  @@map("knowledge_chunks")
}

/// "No leads available right now" for one agent in one dial list. One OPEN row (closedAt null) per agent+list =
/// the dedupe state for the manager alert: a new alert is possible only after work came back (row closed).
model DialerQueueAlert {
  id             String    @id @default(cuid())
  businessId     String    @map("business_id")
  userId         String    @map("user_id")
  listId         String    @map("list_id")
  /// exhausted | waiting
  state          String
  exhaustedCount Int       @default(0) @map("exhausted_count")
  nextAt         DateTime? @map("next_at")
  openedAt       DateTime  @default(now()) @map("opened_at")
  closedAt       DateTime? @map("closed_at")
  notifiedAt     DateTime? @map("notified_at")
  /// [{ to, status, detail }]
  delivery       Json      @default("[]")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, closedAt, openedAt])
  @@index([listId, userId, closedAt])
  @@map("dialer_queue_alerts")
}

/// Immutable snapshot of a package: { modules: { crm: { included, seats } … }, quotas: { metric: limit|null } }.
model PlanVersion {
  id          String   @id @default(cuid())
  planId      String   @map("plan_id")
  version     Int
  name        String
  description String?
  modules     Json     @default("{}")
  quotas      Json     @default("{}")
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  plan       Plan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  businesses Business[]

  @@unique([planId, version])
  @@map("plan_versions")
}

/// Business entitlement on top of the package: an add-on, a trial or a temporary grant of one module.
model EntitlementGrant {
  id          String    @id @default(cuid())
  businessId  String    @map("business_id")
  module      String
  /// addon | trial | temporary
  kind        String
  /// Seats added for this module (null = unlimited).
  seats       Int?
  startsAt    DateTime  @default(now()) @map("starts_at")
  expiresAt   DateTime? @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  note        String?
  createdById String?   @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, module])
  @@map("entitlement_grants")
}

/// Platform-level audit of package / entitlement / permission changes (who, which business / user, what, when).
model AccessAuditLog {
  id             String   @id @default(cuid())
  businessId     String?  @map("business_id")
  actorAccountId String?  @map("actor_account_id")
  targetUserId   String?  @map("target_user_id")
  action         String
  before         Json?
  after          Json?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([businessId, createdAt])
  @@map("access_audit_logs")
}

/// A customer's WhatsApp reply about availability, turned into a dial-queue signal for the lead's owner.
/// One row per inbound message (idempotent). intent: now | later | unavailable | do_not_call | unclear.
/// status: active (priority "זמינה עכשיו" until expiresAt) | scheduled (follow-up set) | needs_review (agent decides)
///   | handled (dial attempt made) | expired (not handled in time) | cancelled (customer / agent) | ineligible (blocked + reason)
model CallbackSignal {
  id          String    @id @default(cuid())
  businessId  String    @map("business_id")
  contactId   String    @map("contact_id")
  leadId      String?   @map("lead_id")
  userId      String?   @map("user_id")
  messageId   String    @unique @map("message_id")
  intent      String
  confidence  Float     @default(0)
  /// ai | basic (rules without an AI key)
  analyzer    String    @default("basic")
  text        String
  requestedAt DateTime  @map("requested_at")
  dueAt       DateTime? @map("due_at")
  expiresAt   DateTime? @map("expires_at")
  status      String
  reason      String?
  acknowledgedAt DateTime? @map("acknowledged_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, userId, status])
  @@index([contactId, status])
  @@map("callback_signals")
}

/// "מנהל AI": a structured operating rule (from free text or a form). kind = momentum | availability | load_cap |
/// approval_policy. `config` holds the thresholds/actions for that kind (see src/server/ops/rules.ts).
model OpsRule {
  id          String    @id @default(cuid())
  businessId  String    @map("business_id")
  kind        String
  name        String
  /// The manager's original wording (null when created from the form / as a default).
  sourceText  String?   @map("source_text")
  config      Json
  /// insight | recommend | auto
  autonomy    String    @default("recommend")
  /// active | paused
  status      String    @default("active")
  /// Lower = stronger (checked first).
  priority    Int       @default(100)
  expiresAt   DateTime? @map("expires_at")
  createdById String?   @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, kind, status])
  @@map("ops_rules")
}

/// A detected opportunity + proposed action waiting for (or past) a manager decision. `evidence` = the numbers
/// computed in code; `proposal` = the exact change. Decided once (atomic status change), linked by `code` on WhatsApp.
model OpsRecommendation {
  id           String    @id @default(cuid())
  businessId   String    @map("business_id")
  ruleId       String?   @map("rule_id")
  /// momentum | availability_unattended
  kind         String
  agentId      String?   @map("agent_id")
  /// pending_manager → pending_agent → active → completed · rejected | expired | cancelled | failed |
  /// needs_adjustment (capacity changed while waiting) · insight (information only, nothing to approve)
  status       String    @default("pending_manager")
  /// Short code for WhatsApp approval ("אשר 4821").
  code         String
  title        String
  explanation  String
  evidence     Json
  proposal     Json
  dedupeKey    String    @map("dedupe_key")
  expiresAt    DateTime  @map("expires_at")
  decidedById  String?   @map("decided_by_id")
  decidedAt    DateTime? @map("decided_at")
  decidedVia   String?   @map("decided_via")
  result       Json?
  notifiedAt   DateTime? @map("notified_at")
  /// Leads: recommended → approved by the manager (ceiling) → confirmed by the agent (≤ manager) → actually assigned.
  requestedCount       Int?      @map("requested_count")
  managerApprovedCount Int?      @map("manager_approved_count")
  agentApprovedCount   Int?      @map("agent_approved_count")
  agentAskedAt         DateTime? @map("agent_asked_at")
  agentRespondedAt     DateTime? @map("agent_responded_at")
  agentReply           String?   @map("agent_reply")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, dedupeKey])
  @@index([businessId, status, createdAt])
  @@map("ops_recommendations")
}

/// Temporary weighted lead distribution on top of the regular policy: `sharePct` of the next `leadLimit` new leads
/// (optionally only of `source`) go to `agentId`, until `expiresAt`. Ends by itself → the regular policy is back.
model AssignmentOverride {
  id               String    @id @default(cuid())
  businessId       String    @map("business_id")
  recommendationId String?   @unique @map("recommendation_id")
  agentId          String    @map("agent_id")
  /// share = sharePct of the next leadLimit leads · extra = leadLimit leads ON TOP of the regular share (taken from
  /// other agents' turns) · priority = the next leadLimit leads go to the agent
  mode             String    @default("share")
  sharePct         Int       @map("share_pct")
  /// Assigned leads are also queued in this campaign (dial list) – the agent must have access to it.
  listId           String?   @map("list_id")
  leadLimit        Int       @map("lead_limit")
  source           String?
  /// Leads distributed while active (all agents) / of them to agentId.
  total            Int       @default(0)
  assigned         Int       @default(0)
  /// active | completed | expired | cancelled
  status           String    @default("active")
  expiresAt        DateTime  @map("expires_at")
  endedAt          DateTime? @map("ended_at")
  endedReason      String?   @map("ended_reason")
  createdById      String?   @map("created_by_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, status])
  @@map("assignment_overrides")
}

/// Meta "Data Deletion Request" / "Deauthorize" callbacks (signed by the app secret). Platform-level (no business):
/// the request is matched to connections by Meta user id; `confirmationCode` is what Meta shows the person.
model MetaDeletionRequest {
  id               String    @id @default(cuid())
  kind             String
  confirmationCode String    @unique @map("confirmation_code")
  metaUserId       String    @map("meta_user_id")
  /// received | completed | no_data
  status           String    @default("received")
  businessIds      String[]  @default([]) @map("business_ids")
  details          Json?
  createdAt        DateTime  @default(now()) @map("created_at")
  completedAt      DateTime? @map("completed_at")

  @@map("meta_deletion_requests")
}

/// Public support / contact form (the support page Meta reviewers and customers use).
model SupportRequest {
  id           String   @id @default(cuid())
  name         String
  email        String
  businessName String?  @map("business_name")
  topic        String
  message      String
  lang         String   @default("he")
  ipHash       String?  @map("ip_hash")
  status       String   @default("open")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("support_requests")
}

/// Approved commercial catalog. Money is stored in minor units; taxes/discounts in basis points.
model SalesOffer {
  id String @id @default(cuid())
  businessId String @map("business_id")
  name String
  description String @default("")
  currency String @default("ILS")
  unitAmount Int @map("unit_amount")
  unitCost Int? @map("unit_cost")
  taxBps Int @default(0) @map("tax_bps")
  maxDiscountBps Int @default(0) @map("max_discount_bps")
  active Boolean @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  @@index([businessId, active])
  @@map("sales_offers")
}

/// Each row is one immutable quote revision. Sharing a new revision revokes the previous link.
model SalesQuote {
  id String @id @default(cuid())
  businessId String @map("business_id")
  leadId String @map("lead_id")
  createdById String @map("created_by_id")
  familyId String @map("family_id")
  revision Int @default(1)
  title String
  currency String
  lines Json
  costTotal Int? @map("cost_total")
  subtotal Int
  tax Int
  total Int
  terms String @default("")
  status String @default("approved")
  expiresAt DateTime @map("expires_at")
  approvedById String? @map("approved_by_id")
  approvedAt DateTime? @map("approved_at")
  tokenHash String? @unique @map("token_hash")
  sharedAt DateTime? @map("shared_at")
  viewedAt DateTime? @map("viewed_at")
  acceptedAt DateTime? @map("accepted_at")
  acceptedName String? @map("accepted_name")
  participants Json @default("[]")
  createdAt DateTime @default(now()) @map("created_at")
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  @@unique([businessId, familyId, revision])
  @@index([businessId, leadId, createdAt])
  @@index([businessId, status])
  @@map("sales_quotes")
}

model MetaAdConnection {
  id String @id @default(cuid())
  businessId String @unique @map("business_id")
  accountId String @map("account_id")
  accountName String @map("account_name")
  tokenSealed String @map("token_sealed")
  verifiedAt DateTime @map("verified_at")
  business Business @relation(fields:[businessId], references:[id], onDelete:Cascade)
  @@map("meta_ad_connections")
}

/// Per-business provider routing for NEW calls (feature flag TELEPHONY_ROUTING=on). No row = platform default, primary only.
model TelephonyRouting {
  businessId       String               @id @map("business_id")
  primaryProvider  TelephonyProvider?   @map("primary_provider")
  backupProvider   TelephonyProvider?   @map("backup_provider")
  mode             TelephonyRoutingMode @default(primary_only)
  /// manual_backup: which provider new calls use right now.
  manualActive     String               @default("primary") @map("manual_active")
  /// Circuit breaker: failures counted within windowSeconds; open for cooldownSeconds; then probeCalls trial calls.
  failureThreshold Int                  @default(5) @map("failure_threshold")
  windowSeconds    Int                  @default(120) @map("window_seconds")
  cooldownSeconds  Int                  @default(300) @map("cooldown_seconds")
  probeCalls       Int                  @default(3) @map("probe_calls")
  /// Cost / usage guard: at most this many NEW calls per day through the backup (null = no limit).
  backupDailyCallLimit Int?             @map("backup_daily_call_limit")
  /// Temporary capacity limits (line / channel limits) count toward failover only when this is on.
  failoverOnCapacity   Boolean          @default(false) @map("failover_on_capacity")
  updatedById      String?              @map("updated_by_id")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("telephony_routing")
}

/// Circuit breaker state per business and provider (only provider/account/auth failures and timeouts count).
model TelephonyProviderHealth {
  id                String                 @id @default(cuid())
  businessId        String                 @map("business_id")
  provider          TelephonyProvider
  state             TelephonyBreakerState  @default(closed)
  failuresInWindow  Int                    @default(0) @map("failures_in_window")
  windowStartedAt   DateTime?              @map("window_started_at")
  openedAt          DateTime?              @map("opened_at")
  nextProbeAt       DateTime?              @map("next_probe_at")
  probeSuccesses    Int                    @default(0) @map("probe_successes")
  probesStarted     Int                    @default(0) @map("probes_started")
  /// Anti-flapping: consecutive trips and the last close (cooldown doubles on a quick re-trip).
  trips             Int                    @default(0)
  closedAt          DateTime?              @map("closed_at")
  lastFailureClass  TelephonyFailureClass? @map("last_failure_class")
  lastFailureDetail String?                @map("last_failure_detail")
  lastFailureAt     DateTime?              @map("last_failure_at")
  lastSuccessAt     DateTime?              @map("last_success_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, provider])
  @@map("telephony_provider_health")
}

/// Every change of the provider used for new calls (manual, automatic failover, recovery, policy change).
model TelephonySwitchLog {
  id           String             @id @default(cuid())
  businessId   String             @map("business_id")
  fromProvider TelephonyProvider? @map("from_provider")
  toProvider   TelephonyProvider? @map("to_provider")
  kind         String
  reason       String?
  actorId      String?            @map("actor_id")
  /// Manager alert for this switch (in-app = this row; WhatsApp to linked managers), sent once.
  notifiedAt   DateTime?          @map("notified_at")
  delivery     Json?
  createdAt    DateTime           @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@map("telephony_switch_log")
}

/// One provider request that may create a call leg. A business call (Call) has one provider for life; its attempts
/// never move to another provider – a new provider means a new Call.
model CallAttempt {
  id                String                 @id @default(cuid())
  businessId        String                 @map("business_id")
  callId            String                 @map("call_id")
  leg               String
  provider          TelephonyProvider
  /// Non-secret account reference (e.g. the Call Control App id), never a key.
  providerAccount   String?                @map("provider_account")
  /// Stable id sent to the provider as command_id; the same key is reused on a retry to the same provider only.
  commandKey        String                 @unique @map("command_key")
  providerLegId     String?                @map("provider_leg_id")
  providerSessionId String?                @map("provider_session_id")
  fromE164          String?                @map("from_e164")
  toE164            String?                @map("to_e164")
  status            TelephonyAttemptStatus @default(requested)
  failureClass      TelephonyFailureClass? @map("failure_class")
  failureDetail     String?                @map("failure_detail")
  httpStatus        Int?                   @map("http_status")
  requestedAt       DateTime               @default(now()) @map("requested_at")
  respondedAt       DateTime?              @map("responded_at")
  settledAt         DateTime?              @map("settled_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  call     Call     @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([callId])
  @@index([businessId, requestedAt])
  @@index([providerLegId])
  @@map("call_attempts")
}

/// Platform-level check of a provider account's configuration (read-only API calls, never a paid call).
model TelephonyProviderAccount {
  id         String            @id @default(cuid())
  provider   TelephonyProvider
  accountRef String            @map("account_ref")
  ok         Boolean           @default(false)
  verifiedAt DateTime?         @map("verified_at")
  checkedAt  DateTime          @default(now()) @map("checked_at")
  detail     Json?

  @@unique([provider, accountRef])
  @@map("telephony_provider_accounts")
}

/// A business's own account at a telephony provider (e.g. Zadarma). Secrets are sealed (AES-GCM, ENCRYPTION_KEY) and
/// never returned to the browser. The row id is the opaque account id in the provider's webhook URL.
model TelephonyProviderCredential {
  id                   String            @id @default(cuid())
  businessId           String            @map("business_id")
  provider             TelephonyProvider
  /// Sealed JSON { apiKey, apiSecret }.
  secrets              String
  sandbox              Boolean           @default(false)
  /// Outgoing caller ID shown to customers, and how it was approved (a number bought at this provider, or an external
  /// number the provider verified). Never used before an owner approves it.
  callerIdE164         String?           @map("caller_id_e164")
  callerIdSource       String?           @map("caller_id_source")
  callerIdApprovedAt   DateTime?         @map("caller_id_approved_at")
  callerIdApprovedById String?           @map("caller_id_approved_by_id")
  /// Numbers the owner approved for a live (paid) test call. Customers are never used for tests.
  testNumbers          String[]          @default([]) @map("test_numbers")
  /// Concurrent calls the account's plan allows (entered from the provider plan; enforced before dialing).
  maxConcurrent        Int?              @map("max_concurrent")
  lastCheckAt          DateTime?         @map("last_check_at")
  lastCheckOk          Boolean?          @map("last_check_ok")
  lastCheckDetail      Json?             @map("last_check_detail")
  /// Set when a live test call produced the provider's call events end to end. Required before real traffic.
  liveTestPassedAt     DateTime?         @map("live_test_passed_at")
  liveTestCallId       String?           @map("live_test_call_id")
  updatedById          String?           @map("updated_by_id")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, provider])
  @@map("telephony_provider_credentials")
}

/// An agent's address at a provider that is not Telnyx (e.g. a Zadarma PBX extension "101").
model TelephonyAgentEndpoint {
  id         String            @id @default(cuid())
  businessId String            @map("business_id")
  userId     String            @map("user_id")
  provider   TelephonyProvider
  extension  String
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@unique([businessId, provider, extension])
  @@map("telephony_agent_endpoints")
}
