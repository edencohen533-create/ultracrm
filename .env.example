# ─── Database (new, isolated PostgreSQL database for UltraCRM) ───────────────
# Pooled connection for the app. Do NOT point this at the dialer / solinainbox databases.
DATABASE_URL="postgresql://user:password@host/ultracrm?sslmode=require"
# Optional: connections per server instance (default 10).
# DATABASE_POOL_MAX=10
# Direct (non-pooled) connection – used only by `prisma migrate`.
DATABASE_URL_UNPOOLED="postgresql://user:password@host-direct/ultracrm?sslmode=require"

# ─── Shared ──────────────────────────────────────────────────────────────────
# Session signing key (min 32 chars): openssl rand -hex 32
JWT_SECRET="change-me-min-32-chars"
# Protects background job routes (/api/jobs/*). Vercel Cron sends it automatically.
CRON_SECRET="change-me"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Telephony (Telnyx) – server-side only ───────────────────────────────────
# "mock" = clearly-marked simulation, "telnyx" = real calls (all four keys required)
TELEPHONY_PROVIDER="mock"
TELNYX_API_KEY=""
# Mission Control → Account Settings → Keys & Credentials → Public Key (base64), verifies Ed25519 webhooks
TELNYX_PUBLIC_KEY=""
# Voice → Call Control Application. Webhook URL: https://<domain>/api/webhooks/telnyx
TELNYX_CALL_CONTROL_APP_ID=""
# Voice → SIP Connections → Credential Connection (agents' WebRTC browsers register against it)
TELNYX_CREDENTIAL_CONNECTION_ID=""

# ─── Messaging (WhatsApp / Meta Cloud API) ───────────────────────────────────
# No env vars: credentials are stored per business in Settings → חיבורים (ProviderCredential).
# Webhook URL to register at Meta: https://<domain>/api/webhooks/whatsapp

# ─── Secrets at rest ─────────────────────────────────────────────────────────
# AES-256-GCM key (32 bytes, hex): openssl rand -hex 32. Required to store WhatsApp tokens.
ENCRYPTION_KEY=""

# ─── Meta app for WhatsApp Embedded Signup (Tech Provider) ───────────────────
# App Dashboard → App settings → Basic. Business-type app with the "WhatsApp" and
# "Facebook Login for Business" products. Never expose META_APP_SECRET to the browser.
META_APP_ID=""
META_APP_SECRET=""
# Facebook Login for Business → Configurations → the Embedded Signup configuration ID
# (permissions whatsapp_business_management + whatsapp_business_messaging, business token).
META_ES_CONFIG_ID=""
# Graph API version used for the JS SDK and server calls (default v25.0).
META_GRAPH_VERSION="v25.0"
# WhatsApp → Configuration → Webhook: Callback URL = https://<domain>/api/webhooks/whatsapp,
# Verify Token = this value. Subscribe to: messages, account_update, account_review_update,
# phone_number_quality_update, phone_number_name_update, business_capability_update.
META_WEBHOOK_VERIFY_TOKEN=""
